APP_NAME="Portfolio Teguh"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=__SITE_URL__

LOG_CHANNEL=single
LOG_LEVEL=error

# --- ISI BAGIAN INI dengan data dari hPanel > Databases > MySQL Databases ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ISI_NAMA_DATABASE
DB_USERNAME=ISI_USERNAME_DATABASE
DB_PASSWORD=ISI_PASSWORD_DATABASE
# -------------------------------------------------------------------------

# Tanpa terminal/worker: jangan pakai queue database, dan simpan cache/session di file.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# Upload gambar ditulis langsung ke <web-root>/storage (tanpa symlink).
PUBLIC_DISK_IN_WEBROOT=true
FILESYSTEM_DISK=local
